# Copia este archivo como .env y ajusta los valores.

# MongoDB local (instalado en tu equipo):
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (en la nube): copia la cadena de conexión desde Atlas > Connect > Drivers
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=traductor_senas

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRETO=cambia-esto-en-produccion

# Administrador que se crea al iniciar si no existe ninguno
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@senas.app
ADMIN_CONTRASENA=Admin12345

# Ollama: corrige las frases deletreadas en «Señas → Texto» (opcional; sin Ollama el resto funciona igual).
# Instálalo desde ollama.com y descarga el modelo con: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2

# Correo para recuperar la contraseña (opcional). Sin esto, el enlace aparece en la consola del servidor.
# Con Gmail: activa la verificación en dos pasos y crea una «contraseña de aplicación».
# SMTP_SERVIDOR=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_USUARIO=tucorreo@gmail.com
# SMTP_CONTRASENA=xxxx xxxx xxxx xxxx
# SMTP_REMITENTE=Intérprete de Señas <tucorreo@gmail.com>
# Dirección del frontend (para armar el enlace del correo)
URL_APP=http://localhost:5173
